{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd app && npm run build",
  "installCommand": "npm install",
  "outputDirectory": "app/.next",
  "framework": "nextjs",
  "regions": [
    "dub1"
  ],
  "crons": [
    {
      "path": "/api/cron/aver-invoices",
      "schedule": "*/15 * * * *"
    }
  ]
}
